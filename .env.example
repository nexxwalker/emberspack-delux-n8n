# Delux crew — environment template
#
# Copy to `.env` (which is git-ignored) and fill in what you need:
#     cp .env.example .env
#
# NOTE: the office reads process.env directly — nothing in this project loads
# `.env` for you. Export it into your shell before starting the server:
#     set -a; . ./.env; set +a; npm start
# or pass a single variable inline:  ANTHROPIC_API_KEY=sk-ant-… npm start
#
# Everything here is OPTIONAL. The office runs with no environment variables at
# all: it uses `office.config.json` and the Claude Code login already on this
# machine. Only put real values in `.env`, never in this file.

# --- Claude -----------------------------------------------------------------
# Run without the Claude Code login by pointing the office at the API instead.
# Leave empty (or unset) to use `claude` on this machine.
ANTHROPIC_API_KEY=

# --- Server -----------------------------------------------------------------
# Port to listen on. Overrides `port` in office.config.json. Default: 4520
PORT=

# The exact public origin when the office sits behind a trusted HTTPS proxy,
# e.g. https://workspace.example.com. Enforces that origin on every request and
# marks session cookies Secure. The proxy must provide its own access control:
# the legacy office APIs are shared installation resources.
DELUX_PUBLIC_ORIGIN=

# Alternative private directory for account storage
# (default: ./data/members — contains accounts.json and provider.key).
DELUX_ACCOUNT_DIR=

# --- Storage ----------------------------------------------------------------
# Where member accounts live. Leave DELUX_MONGODB_URI empty to keep the local
# JSON file; set it to use MongoDB (Atlas → Connect → Drivers gives the string).
DELUX_MONGODB_URI=
# Database inside that cluster. Default: delux_crew
DELUX_MONGODB_DB=

# The AES-256-GCM key for stored provider credentials, 64 hex characters. With
# MongoDB this is required before the first start: a generated key could not
# read credentials that are already stored in the cluster. Read a key file's 32
# raw bytes instead with DELUX_PROVIDER_KEY_FILE.
DELUX_PROVIDER_KEY=
DELUX_PROVIDER_KEY_FILE=

# --- Provider verification endpoints (operator-controlled, testing only) -----
# Settings → Verify access sends the saved credential to these destinations.
# Use only trusted endpoints.
DELUX_OPENAI_URL=https://api.openai.com/v1
DELUX_WHATSAPP_URL=https://graph.facebook.com/v25.0

# --- Build / release --------------------------------------------------------
# Which brain folder the build lays out as the graph. Default: ./brain
AO_BRAIN=

# Overrides for a local build only (these belong in office.config.local.json
# for day-to-day use).
AO_NAME=
AO_MODEL=

# Destination for `node scripts/release.mjs --push`, as owner/repository.
# Required only when publishing a release.
RELEASE_REPOSITORY=

# --- CI only (set in GitHub → Settings → Secrets and variables → Actions) ----
# Never put these in .env or commit them.
#   VERCEL_TOKEN       Vercel access token (Account Settings → Tokens)
#   VERCEL_ORG_ID      `vercel link` writes it into .vercel/project.json
#   VERCEL_PROJECT_ID  `vercel link` writes it into .vercel/project.json
