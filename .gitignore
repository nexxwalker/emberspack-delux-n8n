# --- dependencies -----------------------------------------------------------
node_modules/

# --- build output -----------------------------------------------------------
# dist/ is generated by `node build.mjs`. Two files are shipped deliberately:
# the demo office and the static portal, both served by `serve.mjs`.
dist/*
!dist/command-centre-v2.html
!dist/portal.html
dist/vercel/
dist/release/
.eslintcache

# --- runtime data (contains real user content + the AES key) ----------------
# data/members/provider.key encrypts stored provider credentials: losing it
# makes them unreadable, committing it leaks them. Never track this folder.
data/

# --- local configuration ----------------------------------------------------
office.config.local.json
office.agents.local.json
.env
.env.*
!.env.example

# --- secrets ----------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
.id_rsa
secrets.json

# --- the private half of the Brain ------------------------------------------
brain/Agents Office/

# --- logs & coverage --------------------------------------------------------
*.log
logs/
npm-debug.log*
coverage/
.nyc_output/

# --- editors / OS junk ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
*.backup-*

# --- deploy tooling ---------------------------------------------------------
.vercel/
.wrangler/
